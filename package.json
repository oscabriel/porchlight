{
	"name": "porchlight-workspace",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"test": "bun test",
		"check-types": "tsc --noEmit",
		"check": "oxlint && oxfmt --check",
		"fix": "oxlint --fix && oxfmt",
		"schema": "bun run --filter porchlight schema"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.86.0",
		"typescript": "^6",
		"ultracite": "7.12.2"
	},
	"packageManager": "bun@1.4.0"
}
